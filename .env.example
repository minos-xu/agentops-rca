# Development profile for manually supplied local services. Replace placeholders.
# The deployment manager does not overwrite or use this file.
DEEPSEEK_API_KEY=
POSTGRES_DSN=postgresql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:57432/YOUR_DB
REDIS_URL=redis://127.0.0.1:57479/0
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_MODEL_PATH=
RERANKER_MODEL_PATH=~/models/bge-reranker-v2-m3
AGENTOPS_MESSAGE_RATE_LIMIT=10
AGENTOPS_MESSAGE_RATE_WINDOW_SECONDS=60
AGENTOPS_CASE_CACHE_TTL_SECONDS=30
