# Hybrid deployment; scripts/manage.sh init generates a private .env.docker.
# Never copy a real database password or API key into this template.
DEPLOYMENT_NAME=agentops-rca
POSTGRES_USER=agentops
POSTGRES_DB=agentops
POSTGRES_PASSWORD=
POSTGRES_PORT=57432
REDIS_PORT=57479
API_PORT=8164
AGENTOPS_DATA_DIR=.deployment/data
# Empty uses BAAI/bge-small-zh-v1.5 in the existing offline HF cache.
EMBEDDING_MODEL_PATH=
HF_HOME=~/.cache/huggingface
RERANKER_MODEL_PATH=~/models/bge-reranker-v2-m3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
AGENTOPS_MESSAGE_RATE_LIMIT=10
AGENTOPS_MESSAGE_RATE_WINDOW_SECONDS=60
AGENTOPS_CASE_CACHE_TTL_SECONDS=30
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
TOKENIZERS_PARALLELISM=false
